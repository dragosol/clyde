#!/usr/bin/env python3
"""
parse_filesystem.py — Scan a directory tree into state.json

Usage:
  python3 parse_filesystem.py <input_path> <state_dir> [--max-depth N] [--exclude pattern,...]

Creates:
  <state_dir>/state.json — master item list with all files
"""

import json
import os
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path


# Default exclusions — hidden dirs, OS junk, build artifacts
DEFAULT_EXCLUDES = {
    ".git", ".svn", ".hg", "__pycache__", "node_modules", ".DS_Store",
    "Thumbs.db", ".Trash", ".Spotlight-V100", ".fseventsd",
}


def scan_directory(
    root: Path,
    max_depth: int = 10,
    excludes: 'set[str] | None' = None,
) -> list[dict]:
    """Recursively scan a directory, collecting file metadata."""
    if excludes is None:
        excludes = DEFAULT_EXCLUDES

    items: list[dict] = []

    def walk(current: Path, depth: int, rel_parts: list[str]):
        if depth > max_depth:
            return
        try:
            entries = sorted(current.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))
        except PermissionError:
            return

        for entry in entries:
            if entry.name in excludes:
                continue

            rel_path = "/".join(rel_parts + [entry.name])

            if entry.is_file():
                try:
                    stat = entry.stat()
                    items.append({
                        "path": str(entry),
                        "relative_path": rel_path,
                        "name": entry.name,
                        "extension": entry.suffix.lower(),
                        "size_bytes": stat.st_size,
                        "modified": datetime.fromtimestamp(stat.st_mtime, tz=timezone.utc).isoformat(),
                        "created": datetime.fromtimestamp(stat.st_ctime, tz=timezone.utc).isoformat(),
                        "parent_dir": "/".join(rel_parts) if rel_parts else "",
                    })
                except (OSError, PermissionError):
                    pass

            elif entry.is_dir():
                walk(entry, depth + 1, rel_parts + [entry.name])

    walk(root, 0, [])
    return items


def build_state(source_path: str, files: list[dict]) -> dict:
    items = []
    for i, f in enumerate(files):
        items.append({
            "id": i,
            "original": f,
            "classification": None,
            "status": "pending",
        })

    return {
        "job_id": str(uuid.uuid4()),
        "source_type": "filesystem",
        "source_path": source_path,
        "created_at": datetime.now(tz=timezone.utc).isoformat(),
        "updated_at": datetime.now(tz=timezone.utc).isoformat(),
        "settings": {
            "ambiguity_mode": "batch_and_ask",
            "execution_mode": "hybrid",
            "batch_strategy": "adaptive",
        },
        "items": items,
        "progress": {
            "phase": "ingest",
            "next_batch_start": 0,
            "batch_size": 30,
            "total_classified": 0,
            "total_uncertain": 0,
            "total_pending": len(items),
        },
    }


def main():
    if len(sys.argv) < 3:
        print("Usage: parse_filesystem.py <input_path> <state_dir> [--max-depth N]", file=sys.stderr)
        sys.exit(1)

    input_path = Path(sys.argv[1]).expanduser().resolve()
    state_dir = Path(sys.argv[2]).expanduser().resolve()

    max_depth = 10
    excludes = set(DEFAULT_EXCLUDES)

    i = 3
    while i < len(sys.argv):
        if sys.argv[i] == "--max-depth" and i + 1 < len(sys.argv):
            max_depth = int(sys.argv[i + 1])
            i += 2
        elif sys.argv[i] == "--exclude" and i + 1 < len(sys.argv):
            excludes.update(sys.argv[i + 1].split(","))
            i += 2
        else:
            i += 1

    if not input_path.is_dir():
        print(f"ERROR: Not a directory: {input_path}", file=sys.stderr)
        sys.exit(1)

    state_dir.mkdir(parents=True, exist_ok=True)
    (state_dir / "batches").mkdir(exist_ok=True)

    files = scan_directory(input_path, max_depth=max_depth, excludes=excludes)
    state = build_state(str(input_path), files)

    tmp_path = state_dir / "state.json.tmp"
    final_path = state_dir / "state.json"
    tmp_path.write_text(json.dumps(state, indent=2, ensure_ascii=False), encoding="utf-8")
    tmp_path.rename(final_path)

    (state_dir / "taxonomy.json").write_text(
        json.dumps({"categories": {}, "version": 0}, indent=2), encoding="utf-8"
    )
    (state_dir / "pending_review.json").write_text(
        json.dumps({"items": []}, indent=2), encoding="utf-8"
    )

    # Summary
    print(f"OK: Scanned {len(files)} files from {input_path}")
    print(f"  State dir: {state_dir}")
    print(f"  Job ID: {state['job_id']}")

    # Extension distribution
    ext_counts: dict[str, int] = {}
    for f in files:
        ext = f.get("extension", "") or "(no ext)"
        ext_counts[ext] = ext_counts.get(ext, 0) + 1
    if ext_counts:
        print(f"  File types ({len(ext_counts)}):")
        for ext, count in sorted(ext_counts.items(), key=lambda x: -x[1])[:15]:
            print(f"    {ext}: {count}")


if __name__ == "__main__":
    main()
